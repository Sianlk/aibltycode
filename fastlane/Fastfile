# Fastfile for AIblty (Capacitor Android release automation)
# Requires: GOOGLE_PLAY_KEY_FILE (service account JSON), Android SDK + JDK 17,
# and the upload keystore referenced by android/keystore.properties.

default_platform(:android)

platform :android do
  desc "Build the web app and sync it into the Android project"
  lane :prepare do
    sh("cd .. && npm ci && npm run build && npx cap sync android")
  end

  desc "Build a signed release AAB"
  lane :build_aab do
    prepare
    gradle(
      project_dir: "android",
      task: "bundle",
      build_type: "Release"
    )
  end

  desc "Upload to Google Play internal testing"
  lane :beta do
    build_aab
    upload_to_play_store(
      track: "internal",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      release_status: "draft",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote the latest internal build to production"
  lane :promote do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Build and release straight to production (staged 20% rollout)"
  lane :release do
    build_aab
    upload_to_play_store(
      track: "production",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      rollout: "0.2",
      metadata_path: "fastlane/metadata/android",
      skip_upload_apk: true
    )
  end

  desc "Upload store listing text, screenshots and feature graphic only"
  lane :listing do
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: false,
      metadata_path: "fastlane/metadata/android"
    )
  end
end
